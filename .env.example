# Copy to .env and fill in values.

# OpenAI API (required for inference.py / evaluate.py)
OPENAI_API_KEY=sk-...

# Optional: custom API base (OpenAI-compatible proxies, Azure, etc.)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model id for chat completions
OPENAI_MODEL=gpt-4o-mini

# OpenEnv HTTP server (run: uv run server)
ENV_SERVER_URL=http://localhost:8000

# Active task id (must match a folder under tasks/). Server reads this at startup.
# EARNINGS_ANALYST_TASK_ID=sentiment_label
