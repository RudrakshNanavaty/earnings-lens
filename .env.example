# Copy to .env and fill in values.

# -----------------------------------------------------------------------
# Hackathon-required variables (injected by the evaluator at submission)
# -----------------------------------------------------------------------

# Hugging Face / API key for the LLM
HF_TOKEN=

# LLM API endpoint (OpenAI-compatible)
API_BASE_URL=https://router.huggingface.co/v1

# Model identifier
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Docker image for the environment (triggers from_docker_image when set)
IMAGE_NAME=earnings_analyst-env:latest

# -----------------------------------------------------------------------
# Local development fallbacks (used when the above are absent)
# -----------------------------------------------------------------------

# Alternative API key (e.g. OpenAI, Google Gemini, etc.)
OPENAI_API_KEY=sk-...

# Alternative model name
OPENAI_MODEL=gpt-4o-mini

# HTTP base URL of a locally running OpenEnv server (uv run server)
ENV_SERVER_URL=http://localhost:8000

# Active task id loaded by the server at startup
# EARNINGS_ANALYST_TASK_ID=sentiment_label
